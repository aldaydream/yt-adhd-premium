{
  "manifest_version": 3,
  "name": "ADHD MultiView",
  "description": "Watch up to four videos in tiled layouts next to the YouTube feed, with one audio source. Works with YouTube. Not affiliated with YouTube or Google.",
  "version": "0.2.0",
  "minimum_chrome_version": "110",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://www.youtube-nocookie.com/*"
  ],
  "action": {
    "default_title": "ADHD MultiView: open or close the panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
